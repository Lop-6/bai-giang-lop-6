    "bam": "58b7173fc00717c0"
  },
  "gs-11": {
    "file": "gs-11.mp3",
    "kieu": "don",
    "text": "That sounds interesting. Is there anything special people should do?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
