  "read-01": {
    "file": "read-01.mp3",
    "kieu": "ten",
    "text": "My neighbourhood. I live in the suburbs of Da Nang City. There are many things I like about my neighbourhood.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Da Nang",
        "doc": "Đà Nẵng",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "88adafe519a0a9c1"
  },
  "read-02": {
    "file": "read-02.mp3",
    "kieu": "don",
    "text": "It's great for outdoor activities because it has beautiful parks, sandy beaches and fine weather. There's almost everything I need here: shops, restaurants, and markets. The people here are friendlier, and the food is better than in other places.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "c0e970276fb280e8"
  },
  "read-03": {
    "file": "read-03.mp3",
    "kieu": "don",
    "text": "However, there are two things I dislike about it: there are many modern buildings and offices; and the streets are busy and crowded.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "34e6a541a4d4239c"
  }
}