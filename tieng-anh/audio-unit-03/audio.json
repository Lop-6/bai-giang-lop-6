    {"slug": "gr-01", "voice": "F", "text": "She's talking."},
    {"slug": "gr-02", "voice": "F", "text": "They're not talking."},
    {"slug": "gr-03", "voice": "F", "text": "I'm doing my homework at present."},
    {"slug": "gr-04", "voice": "M", "text": "Are you reading now?"},
    {"slug": "gr-05", "voice": "F", "text": "Yes, I am."},
    {"slug": "gr-06", "voice": "F", "text": "She's talking to Mai.", "ten_viet": ["Mai"]},
    {"slug": "gr-07", "voice": "M", "text": "Is your sister making a cake?"},
