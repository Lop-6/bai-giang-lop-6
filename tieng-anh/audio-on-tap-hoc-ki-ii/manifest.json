  "gr-u7-1": {
    "file": "gr-u7-1.mp3",
    "kieu": "don",
    "text": "Each question word is used for a specific piece of information.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e8e752d6eb31090a"
  },
  "gr-u7-2": {
    "file": "gr-u7-2.mp3",
    "kieu": "don",
    "text": "We use a conjunction to combine two clauses into a compound sentence.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "bc70f6d35336f944"
  },
  "gr-u7-3": {
    "file": "gr-u7-3.mp3",
    "kieu": "don",
    "text": "I like watching cartoons, but my brother likes watching sports.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "caf5c942beb1a9c8"
  },
  "gr-u7-4": {
    "file": "gr-u7-4.mp3",
    "kieu": "don",
    "text": "I enjoy sports, so I spend a lot of time outdoors.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4e294c93ad4b6a10"
  },
  "gr-u7-5": {
    "file": "gr-u7-5.mp3",
    "kieu": "don",
    "text": "I'm helping decorate the house, and my brother is busy cooking.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "d144e88a7c6076aa"
  },
  "gr-u8-1": {
    "file": "gr-u8-1.mp3",
    "kieu": "don",
    "text": "We use the past simple to talk about something that happened in the past.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "53f7000329604ff2"
  },
  "gr-u8-2": {
    "file": "gr-u8-2.mp3",
    "kieu": "ten",
    "text": "I played badminton with Phong yesterday.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Phong",
        "doc": "Phong",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "ca7e20d3279f9cbd"
  },
  "gr-u8-3": {
    "file": "gr-u8-3.mp3",
    "kieu": "don",
    "text": "We use imperatives to tell someone to do something, or to give a direct order.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "91f71a7b61db8b49"
  },
  "gr-u8-4": {
    "file": "gr-u8-4.mp3",
    "kieu": "don",
    "text": "Chew it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "1c6b272a808e18b8"
  },
  "gr-u8-5": {
    "file": "gr-u8-5.mp3",
    "kieu": "don",
    "text": "Don't swallow it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c545322c27ceaeb3"
  },
  "gr-u9-1": {
    "file": "gr-u9-1.mp3",
    "kieu": "don",
    "text": "A possessive adjective is used only when there's a noun following it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e21837472108691c"
  },
  "gr-u9-2": {
    "file": "gr-u9-2.mp3",
    "kieu": "don",
    "text": "This is my pen.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "2aec089b2f283a47"
  },
  "gr-u9-3": {
    "file": "gr-u9-3.mp3",
    "kieu": "don",
    "text": "A possessive pronoun is used alone, without a noun following it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "f305a16c4755dcfd"
  },
  "gr-u9-4": {
    "file": "gr-u9-4.mp3",
    "kieu": "don",
    "text": "This book is mine, not yours.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0a2919e45aef6d79"
  },
  "gr-u10-1": {
    "file": "gr-u10-1.mp3",
    "kieu": "don",
    "text": "We use the future simple to talk about an action that happens in the future.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e5e2ec618df1b2fa"
  },
  "gr-u10-2": {
    "file": "gr-u10-2.mp3",
    "kieu": "don",
    "text": "We'll live in that cottage next year.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "f11a5dd3bcba601a"
  },
  "gr-u10-3": {
    "file": "gr-u10-3.mp3",
    "kieu": "don",
    "text": "We won't live in that cottage anytime soon.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8fe17dad40d95bfa"
  },
  "gr-u10-4": {
    "file": "gr-u10-4.mp3",
    "kieu": "don",
    "text": "We use might + V to talk about actions that are possible in the future (we are not sure if they will happen or not).",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "7cd05cdd3c2d403e"
  },
  "gr-u10-5": {
    "file": "gr-u10-5.mp3",
    "kieu": "don",
    "text": "We might live in a UFO.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "9f84c7ed9480ae8d"
  },
  "gr-u11-1": {
    "file": "gr-u11-1.mp3",
    "kieu": "don",
    "text": "An ant is a tiny animal.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c235cd5a14ce87e8"
  },
  "gr-u11-2": {
    "file": "gr-u11-2.mp3",
    "kieu": "don",
    "text": "I'm a student.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8ed976bd1dd8c8f8"
  },
  "gr-u11-3": {
    "file": "gr-u11-3.mp3",
    "kieu": "don",
    "text": "I have an eraser.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "29b11f454b827497"
  },
  "gr-u11-4": {
    "file": "gr-u11-4.mp3",
    "kieu": "don",
    "text": "The bike in front of her house is nice.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "7ebacdd1e276fe50"
  },
  "gr-u11-5": {
    "file": "gr-u11-5.mp3",
    "kieu": "don",
    "text": "The air is dirty.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0cc140fc6e9b5560"
  },
  "gr-u11-6": {
    "file": "gr-u11-6.mp3",
    "kieu": "don",
    "text": "First conditional sentences describe things which are possible and likely to happen in the present or the future.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a0e686bf9ad40201"
  },
  "gr-u11-7": {
    "file": "gr-u11-7.mp3",
    "kieu": "don",
    "text": "If you use less paper, you will save a lot of trees.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "006f545145cdf838"
  },
  "gr-u12-1": {
    "file": "gr-u12-1.mp3",
    "kieu": "don",
    "text": "We use superlative adjectives to compare three or more people or things.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "00b3ba12fabdafb3"
  },
  "gr-u12-2": {
    "file": "gr-u12-2.mp3",
    "kieu": "don",
    "text": "Tom is the tallest in his class.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a19ffc8f7dd6177c"
  },
  "gr-u12-3": {
    "file": "gr-u12-3.mp3",
    "kieu": "don",
    "text": "This is the biggest of the three bags.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "bd12e3b9aab6ed43"
  },
