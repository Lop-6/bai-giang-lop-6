    {"slug": "gs-01", "voice": "F", "vai": "Alice", "text": "Hello, welcome to our Geography Club."},
    {"slug": "gs-02", "voice": "F", "vai": "Alice", "text": "Come in, Elena. We're just starting now. But remember you must always be on time."},
    {"slug": "gs-03", "voice": "F2", "vai": "Elena", "text": "Sure. Sorry."},
    {"slug": "gs-04", "voice": "F", "vai": "Alice", "text": "Today I'm going to talk about some natural wonders of Viet Nam.",
     "ten_viet": [{"tu": "Viet Nam", "doc": "Việt Nam"}]},
    {"slug": "gs-05", "voice": "M", "vai": "Nick", "text": "Great! What's that in the first picture?"},
    {"slug": "gs-06", "voice": "F", "vai": "Alice", "text": "It's Ganh Da Dia in Dak Lak.",
     "ten_viet": [{"tu": "Ganh Da Dia", "doc": "Gành Đá Đĩa"}, {"tu": "Dak Lak", "doc": "Đắk Lắk"}]},
    {"slug": "gs-07", "voice": "F2", "vai": "Elena", "text": "Wow. It looks amazing!"},
    {"slug": "gs-08", "voice": "M", "vai": "Nick", "text": "Is picture two Ha Long Bay?",
     "ten_viet": [{"tu": "Ha Long", "doc": "Hạ Long"}]},
    {"slug": "gs-09", "voice": "F", "vai": "Alice", "text": "Right. What do you know about it?"},
    {"slug": "gs-10", "voice": "M", "vai": "Nick", "text": "It has many islands."},
    {"slug": "gs-11", "voice": "F", "vai": "Alice", "text": "Yeah! The scenery is wonderful. This picture shows Tuan Chau, a large island.",
     "ten_viet": [{"tu": "Tuan Chau", "doc": "Tuần Châu"}]},
    {"slug": "gs-12", "voice": "M2", "vai": "Tommy", "text": "How about picture three?"},

