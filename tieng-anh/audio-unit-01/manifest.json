  "gr-05": {
    "file": "gr-05.mp3",
    "kieu": "don",
    "text": "We use the present simple to talk about actions or events that often happen, or are fixed.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "9489977445211044"
  },
  "gr-06": {
    "file": "gr-06.mp3",
    "kieu": "don",
    "text": "We use adverbs of frequency to show how often something happens.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "ff8afa54f4690276"
  },
  "gr-07": {
    "file": "gr-07.mp3",
    "kieu": "don",
    "text": "We usually place the adverb of frequency before the main verb.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0c825f48838c7ac6"
  },
  "gr-10": {
    "file": "gr-10.mp3",
    "kieu": "don",
    "text": "The present simple verbs with he, she, it need an s, es.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "3d9812097b6e00bd"
  },
  "gr-11": {
    "file": "gr-11.mp3",
    "kieu": "don",
    "text": "We often use them with the present simple.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "16711b41319089f4"
  },
