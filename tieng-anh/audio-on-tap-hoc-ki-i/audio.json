  {
   "slug": "gr-u1-1",
   "text": "We use the present simple to talk about actions or events that often happen, or are fixed.",
   "voice": "F"
  },
  {
   "slug": "gr-u1-2",
   "text": "The present simple verbs with he / she / it need an s / es.",
   "voice": "F"
  },
  {
   "slug": "gr-u1-3",
   "text": "We usually place the adverb of frequency before the main verb.",
   "voice": "F"
  },
  {
   "slug": "gr-u1-4",
   "text": "Tom usually takes the bus to school.",
   "voice": "F"
  },
  {
   "slug": "gr-u3-1",
   "text": "When something often happens or is fixed, we use the present simple.",
   "voice": "F"
  },
  {
   "slug": "gr-u3-2",
   "text": "When something is happening now, we use the present continuous.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-1",
   "text": "We use 's after a proper name.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-2",
   "text": "This is Elena's room.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-3",
   "text": "We use 's after a singular noun.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-4",
   "text": "This is my mum's book.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-5",
   "text": "Prepositions of place describe where people or things are.",
   "voice": "F"
  },
  {
   "slug": "gr-u2-6",
   "text": "in, on, next to, behind",
   "voice": "F"
  },
  {
   "slug": "gr-u2-7",
   "text": "in front of, under, between",
   "voice": "F"
  },
  {
   "slug": "gr-u4-1",
   "text": "We can use comparative adjectives to compare two people or things.",
   "voice": "F"
  },
  {
   "slug": "gr-u4-2",
   "text": "Tom is taller than Mary.",
   "voice": "F"
  },
  {
   "slug": "gr-u4-3",
   "text": "A house in a city is normally more expensive than a house in the countryside.",
   "voice": "F"
  },
  {
   "slug": "gr-u5-1",
   "text": "We use some, many, a few with countable nouns.",
   "voice": "F"
  },
  {
   "slug": "gr-u5-2",
   "text": "We use some, much, a little with uncountable nouns.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-1",
   "text": "My mother bought some fruits.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-2",
   "text": "I need some milk for the cake.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-3",
   "text": "I can't answer any questions.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-4",
   "text": "Do you have any sugar?",
   "voice": "F"
  },
  {
   "slug": "gr-u5-3",
   "text": "We use must to say that something is very necessary or very important.",
   "voice": "F"
  },
  {
   "slug": "gr-u5-4",
   "text": "We use mustn't to say that doing something is not allowed.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-5",
   "text": "We use should for things that are good to do.",
   "voice": "F"
  },
  {
   "slug": "gr-u6-6",
   "text": "We use shouldn't for things that are not good to do.",
   "voice": "F"
  },
