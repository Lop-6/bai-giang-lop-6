      }
    ],
    "bam": "e3c5c26d4089cd4a"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "Wow. It looks amazing!",
    "voice": "en-GB-LibbyNeural",
    "rate": "+0%",
    "bam": "9f1c2ac3eca664f4"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "ten",
    "text": "Is picture two Ha Long Bay?",
    "voice": "en-GB-RyanNeural",
