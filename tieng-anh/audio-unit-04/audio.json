    {"slug": "gs-01", "voice": "M", "vai": "Phong", "text": "Wow! We're in Hoi An. I'm so excited.", "ten_viet": [{"tu": "Hoi An", "doc": "Hội An"}]},
    {"slug": "gs-02", "voice": "M3", "vai": "Nick", "text": "Me too. It's so beautiful. Where shall we go first?"},
    {"slug": "gs-03", "voice": "M2", "vai": "Khang", "text": "Let's go to Chua Cau.", "ten_viet": [{"tu": "Chua Cau", "doc": "Chùa Cầu"}]},
    {"slug": "gs-04", "voice": "M", "vai": "Phong", "text": "Well, but Tan Ky House is nearer. Shall we go there first?", "ten_viet": [{"tu": "Tan Ky", "doc": "Tấn Ký"}]},
    {"slug": "gs-05", "voice": "M2", "text": "OK, sure."},
    {"slug": "gs-06", "voice": "M", "vai": "Phong", "text": "First, cross the road, and then turn left."},
    {"slug": "gs-07", "voice": "M3", "vai": "Nick", "text": "Fine, let's go."},
    {"slug": "gs-08", "voice": "M", "vai": "Phong", "text": "Wait."},
    {"slug": "gs-09", "voice": "M2", "vai": "Khang", "text": "What's up, Phong?", "ten_viet": ["Phong"]},
    {"slug": "gs-10", "voice": "M", "vai": "Phong", "text": "I think we're lost."},
    {"slug": "gs-11", "voice": "M3", "vai": "Nick", "text": "Look, there's a girl. Let's ask her."},
    {"slug": "gs-12", "voice": "M", "vai": "Phong", "text": "Excuse me? Can you tell us the way to Tan Ky House?", "ten_viet": [{"tu": "Tan Ky", "doc": "Tấn Ký"}]},
