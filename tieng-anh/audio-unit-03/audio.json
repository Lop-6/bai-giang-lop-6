    {"slug": "gs-06", "voice": "M2", "text": "Look! It's Mai. And she is with someone.", "ten_viet": ["Mai"]},
    {"slug": "gs-07", "voice": "M", "text": "Oh, who's that? She has glasses and long black hair."},
    {"slug": "gs-08", "voice": "M2", "text": "I don't know. They're coming over."},
