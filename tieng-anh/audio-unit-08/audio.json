    { "slug": "read-00", "voice": "F", "text": "The PE teacher is talking to her students about Pelé." },
    { "slug": "read-01", "voice": "F", "vai": "Teacher", "text": "Today we're going to talk about Pelé. Do you know him?" },
    { "slug": "read-02", "voice": "M", "vai": "Nick", "text": "Yes, I think he's the best footballer of all time." },
    { "slug": "read-03", "voice": "F", "vai": "Teacher", "text": "Right. He was born in nineteen forty in Brazil. His father taught him to play football at a very young age." },
    { "slug": "read-04", "voice": "F2", "vai": "Susan", "text": "Oh. When did he begin his career in football?" },
    { "slug": "read-05", "voice": "F", "vai": "Teacher", "text": "At fifteen, when he started playing for Santos Football Club. In nineteen fifty-eight, he won his first World Cup." },
    { "slug": "read-06", "voice": "M", "vai": "Nick", "text": "How many goals did he score in his career?" },
    { "slug": "read-07", "voice": "F", "vai": "Teacher", "text": "One thousand two hundred and eighty-one goals in total, I think." },
    { "slug": "read-08", "voice": "M", "text": "Wow! Amazing!" },
    { "slug": "read-09", "voice": "F", "vai": "Teacher", "text": "And he became \"Football Player of the Century\" in nineteen ninety-nine." },
    { "slug": "read-10", "voice": "M2", "vai": "Michael", "text": "Surely Pelé's a national hero in Brazil." },
    { "slug": "read-11", "voice": "F", "vai": "Teacher", "text": "Yes, and he's known around the world as \"The King of Football\"." },

    { "slug": "sp-01", "voice": "F", "text": "Hoang Giang – number one sportsman in shooting", "ten_viet": [ { "tu": "Hoang Giang", "doc": "Hoàng Giang" } ] },
