  },
  "prs-2": {
    "file": "prs-2.mp3",
    "kieu": "don",
    "text": "Where do they stay on their holiday?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "7f133e6338fc883f"
  },
  "prs-3": {
    "file": "prs-3.mp3",
    "kieu": "don",
    "text": "I need some meat for my cat.",
