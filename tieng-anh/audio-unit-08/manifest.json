  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "don",
    "text": "Wow! This gym is big!",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "c0461b446686bb6f"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "ten",
    "text": "Yeah. The equipment is great. What sports do you do, Duong?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duong",
        "doc": "Dương",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "ab053142dad46b76"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "ten",
    "text": "Well, I do karate, and I play table tennis. Yesterday I played with Duy, and I won!",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duy",
        "doc": "Duy",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "1b40331494d90efa"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "don",
    "text": "Congratulations! You look fit! I'm not good at sports.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c6bf567ad33bcca3"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "I have an idea – you can go to the karate club with me.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "719eb730bd1f5b18"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "No, I can't do karate.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "07f7bc7ba44fa7fe"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "But you can learn! You'll love it.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "4cfab616852dfff9"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Well … OK.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "88ca580d8cd8e7e9"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "don",
    "text": "Great! I'll meet you there at ten a.m. on Sunday.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "826ff4204fca7aff"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "don",
    "text": "Where's the club?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "5373537b98a11a5c"
  },
  "gs-11": {
    "file": "gs-11.mp3",
    "kieu": "ten",
    "text": "It's Superfit Club, in Pham Hung  Road. You can cycle there.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Pham Hung",
        "doc": "Phạm Hùng",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "8e406a1e8d8ed48b"
  },
  "gs-12": {
    "file": "gs-12.mp3",
    "kieu": "don",
    "text": "OK. See you then.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "914b0b97a08b6e7b"
  },
