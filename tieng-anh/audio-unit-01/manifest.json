  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "don",
    "text": "Just a minute.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "756b9d0c4aaae4b2"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "ten",
    "text": "Oh, this is Duy, my new friend.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duy",
        "doc": "Duy",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "7c0df59ebe613d06"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "ten",
    "text": "Hi, Duy. Nice to meet you.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duy",
        "doc": "Duy",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "521ab55578f96065"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "ten",
    "text": "Hi, Phong. I live near here, and we go to the same school!",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Phong",
        "doc": "Phong",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "3432ce5f48c48833"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "Good. Hmm, your school bag looks heavy.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "c533e1147d40d259"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Yes! I have new books, and we have new subjects to study.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "7cc734a8d638a3ae"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "ten",
    "text": "And a new uniform, Duy! You look smart!",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duy",
        "doc": "Duy",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "48a3d5881dac66d6"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "ten",
    "text": "Thanks, Phong. We always look smart in our uniforms.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
