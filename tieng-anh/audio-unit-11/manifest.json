  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "don",
    "text": "Hi, Nick.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "b5d18c2231bbde27"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "ten",
    "text": "Hello, Mi.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Mi",
        "doc": "Mi",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "7b83b74580e885cf"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "don",
    "text": "You've bought a lot of things.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "1bb80f0ad298ad05"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "ten",
    "text": "Yes. We're going on a picnic tomorrow. What are you doing at the supermarket, Mi?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Mi",
        "doc": "Mi",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "2fe815ec6082785e"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "I'm buying some eggs. Hey, what's this?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "681f11c16fa4036b"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "It's a reusable shopping bag.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "e26abf5a61b2212d"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "Do you always use it?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "2df191c8f3e3c013"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Yes. It's better than a plastic one. If we all use this kind of bag, we will help the environment.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "d86dd9a7719e958b"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "don",
    "text": "I see. I'll buy one for my mum. Where can I buy one?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4d9a30c4b253de7d"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "don",
    "text": "At the check-out. By the way, you're also green. You're cycling.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "0670ebf81091364a"
  },
  "gs-11": {
    "file": "gs-11.mp3",
    "kieu": "don",
    "text": "You're right. If more people cycle, the air will be cleaner. Right?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "94db2f3821bfe6fa"
  },
  "gs-12": {
    "file": "gs-12.mp3",
    "kieu": "don",
    "text": "Yes. Oh, it's five o'clock already. I have to go now. See you later.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "463c224e0700a251"
  },
  "gs-13": {
    "file": "gs-13.mp3",
    "kieu": "don",
    "text": "See you, Nick. Bye.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4618e8d50df73e9a"
  },
