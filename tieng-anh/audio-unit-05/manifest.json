  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "don",
    "text": "Hello, welcome to our Geography Club.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "407e380bbe2b4070"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "don",
    "text": "Come in, Elena. We're just starting now. But remember you must always be on time.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "cc338b88d587ce0e"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "don",
    "text": "Sure. Sorry.",
    "voice": "en-GB-LibbyNeural",
    "rate": "+0%",
    "bam": "f1105adf045cbc3c"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "ten",
    "text": "Today I'm going to talk about some natural wonders of Viet Nam.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Viet Nam",
        "doc": "Việt Nam",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "85dac298666befe2"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "Great! What's that in the first picture?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "c625353a33e8b394"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "ten",
    "text": "It's Ganh Da Dia in Dak Lak.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
