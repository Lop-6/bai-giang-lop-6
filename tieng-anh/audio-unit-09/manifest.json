  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "don",
    "text": "Tom, are these photos from your holidays?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "36c1d7c127bbd9e1"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "don",
    "text": "Yes, they are. This is Sydney, a city in Australia.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "c13f7870db612772"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "don",
    "text": "What's it like?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "dc467711bff21fec"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "don",
    "text": "It's exciting with a lot of beaches.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "25e9a7976561be3e"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "What a beautiful place!",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4ec5d83a97a0c487"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "Yes, its beaches are very clean.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "d210598b6204d735"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "Wonderful. Oh, this is London. Isn't it raining? What bad weather!",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "2da271f41d7af880"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Yes, it rains all the time. Can you see Big Ben?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "96488314d16073cd"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "don",
    "text": "Yeah … on the River Thames. It's a landmark of London.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "bcbacccdd82b4913"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "don",
    "text": "It is. And this is Times Square in New York, crowded but interesting.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "0b8b24c651b16955"
  },
  "gs-11": {
    "file": "gs-11.mp3",
    "kieu": "don",
    "text": "You're lucky to visit many places.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "b724242eb1e60ca0"
  },
  "gs-12": {
    "file": "gs-12.mp3",
    "kieu": "don",
    "text": "I am. What about your holidays?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "2c630a72059f3747"
  },
  "gs-13": {
    "file": "gs-13.mp3",
    "kieu": "don",
    "text": "Here are some photos of mine. This is …",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c7118b01f838167e"
  },
