    {"slug": "gr-11", "voice": "F2", "text": "Are you looking for something?"},
    {"slug": "gr-12", "voice": "M", "text": "Yes, I am."},
    {"slug": "gr-13", "voice": "F", "text": "When something often happens or is fixed, we use the present simple."},
