    { "slug": "gr-01", "voice": "F", "text": "We use the past simple to talk about something that happened in the past." },
    { "slug": "gr-02", "voice": "F", "text": "I played badminton with Phong yesterday.", "ten_viet": ["Phong"] },
    { "slug": "gr-03", "voice": "F", "text": "Did you do any sport last weekend?" },
    { "slug": "gr-04", "voice": "M", "text": "Oh yes, and I was exhausted." },
    { "slug": "gr-05", "voice": "F2", "text": "Really? What did you do?" },
    { "slug": "gr-06", "voice": "F", "text": "We use imperatives to tell someone to do something, or to give a direct order." },
