    {"slug": "com-01", "voice": "F2", "text": "What does your best friend look like?"},
    {"slug": "com-02", "voice": "F", "text": "She's short with long black hair. She has bright brown eyes."},
    {"slug": "com-03", "voice": "F2", "text": "What's she like?"},
    {"slug": "com-04", "voice": "F", "text": "She's very kind and creative."},
    {"slug": "read-vinh", "voice": "M", "vai": "Vinh", "text": "I live in Da Nang. At home, I can do my homework without my parents' help. At school, I like speaking English. I'm going to an English club now.",
     "ten_viet": [{"tu": "Da Nang", "doc": "Đà Nẵng"}]},
    {"slug": "read-john", "voice": "M2", "vai": "John", "text": "I come from Cambridge. In my free time, I draw pictures and play the piano. I also help some old people near my house. I usually read to them at the weekend. Now I'm drawing in my garden."},

    {"slug": "read-ad", "voice": "F", "text": "The Superb Summer Camp. A perfect present for kids aged between ten and fifteen."},
    {"slug": "read-01", "voice": "M2", "vai": "Nam", "text": "Hi Mum and Dad, Here I am at the Superb Summer Camp. Mr Black asked us to write emails in English! Wow, everything here is in English!"},
    {"slug": "read-02", "voice": "M2", "vai": "Nam", "text": "I have some new friends: Jimmy, Phong, and Nhung. They're in the photo. Jimmy has blonde hair and blue eyes. He's clever and creative. He likes taking photos. Phong is the tall boy. He's sporty and plays basketball very well. Nhung has curly black hair. She's kind. She shared her lunch with me today.",
     "ten_viet": ["Phong", "Nhung", "Phong", "Nhung"]},
    {"slug": "read-03", "voice": "M2", "vai": "Nam", "text": "We're having fun. Jimmy's taking photos of me. Phong's reading a comic book, and Nhung's playing the violin. I must go now.",
     "ten_viet": [{"tu": "Phong's", "doc": "Phong", "giu_duoi": "'s"}, {"tu": "Nhung's", "doc": "Nhung", "giu_duoi": "'s"}]},
    {"slug": "read-04", "voice": "M2", "vai": "Nam", "text": "Please write soon. Love, Nam", "ten_viet": ["Nam"]},
    {"slug": "sp-mi", "voice": "F", "text": "Mi is twelve years old. She likes drawing and writing stories. She's good at English. She's creative and friendly.", "ten_viet": ["Mi"]},
    {"slug": "sp-an", "voice": "M", "text": "An is sixteen years old. He doesn't know English. He's funny and kind.", "ten_viet": ["An"]},
    {"slug": "sp-vy", "voice": "F", "text": "Vy is fourteen years old. She likes playing sports. Her English isn't very good. She's clever, but she isn't active.", "ten_viet": ["Vy"]},
    {"slug": "sp-01", "voice": "F", "text": "I want to go to this camp because I can speak English there."}
