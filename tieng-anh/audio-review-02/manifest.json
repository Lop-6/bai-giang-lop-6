  "gr-u4-1": {
    "file": "gr-u4-1.mp3",
    "kieu": "don",
    "text": "We can use comparative adjectives to compare two people or things.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "cb208e8f687f681a"
  },
  "gr-u4-2": {
    "file": "gr-u4-2.mp3",
    "kieu": "don",
    "text": "Tom is taller than Mary.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "fd6b54064b835d9f"
  },
  "gr-u4-3": {
    "file": "gr-u4-3.mp3",
    "kieu": "don",
    "text": "A house in a city is normally more expensive than a house in the countryside.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a7f8578a34b8dd5f"
  },
  "gr-u5-1": {
    "file": "gr-u5-1.mp3",
    "kieu": "don",
    "text": "Countable nouns are for the people and things we can count using numbers.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "22ecb5dc7d6190c5"
  },
  "gr-u5-2": {
    "file": "gr-u5-2.mp3",
    "kieu": "don",
    "text": "Countable nouns can be singular: a rock, an island, or plural: rocks, islands.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "09fb9b0ec87183fa"
  },
  "gr-u5-3": {
    "file": "gr-u5-3.mp3",
    "kieu": "don",
    "text": "Uncountable nouns are for the things that we cannot count with numbers.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0d163819030cf4ed"
  },
  "gr-u5-4": {
    "file": "gr-u5-4.mp3",
    "kieu": "don",
    "text": "They usually do not have a plural form: cream, chocolate.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "3f94aee2085f6b90"
  },
  "gr-u5-5": {
    "file": "gr-u5-5.mp3",
    "kieu": "don",
    "text": "We use some, many, a few with countable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8de0e1b77b1fb6a3"
  },
  "gr-u5-6": {
    "file": "gr-u5-6.mp3",
    "kieu": "don",
    "text": "We use some, much, a little with uncountable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e3c786be4bc6c6a6"
  },
  "gr-u6-3": {
    "file": "gr-u6-3.mp3",
    "kieu": "don",
    "text": "My mother bought some fruits.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "cfd91f1e119972f9"
  },
  "gr-u6-4": {
    "file": "gr-u6-4.mp3",
    "kieu": "don",
    "text": "I need some milk for the cake.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "20e73f825b321111"
  },
  "gr-u6-5": {
    "file": "gr-u6-5.mp3",
    "kieu": "don",
    "text": "I can't answer any questions.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "db293c8142723feb"
  },
  "gr-u6-6": {
    "file": "gr-u6-6.mp3",
    "kieu": "don",
    "text": "Do you have any sugar?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "065b31d0d15bb0ba"
  },
  "gr-u5-7": {
    "file": "gr-u5-7.mp3",
    "kieu": "don",
    "text": "We use must to say that something is very necessary or very important.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e865b9d5c5d08d6c"
  },
  "gr-u5-8": {
    "file": "gr-u5-8.mp3",
    "kieu": "don",
    "text": "We use mustn't to say that doing something is not allowed.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "edf28e214b6c5f81"
  },
  "gr-u6-1": {
    "file": "gr-u6-1.mp3",
    "kieu": "don",
    "text": "We use should for things that are good to do.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "d531d5accb0d7a73"
  },
  "gr-u6-2": {
    "file": "gr-u6-2.mp3",
    "kieu": "don",
    "text": "We use shouldn't for things that are not good to do.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "5312ae957b2e5207"
  },
