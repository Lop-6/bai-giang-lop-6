    "bam": "ffc745b7f15e6f22"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "don",
    "text": "I think we're lost.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "490d1538d17629ef"
  },
  "gs-11": {
    "file": "gs-11.mp3",
    "kieu": "don",
    "text": "Look, there's a girl. Let's ask her.",
    "voice": "en-GB-ThomasNeural@+20Hz",
    "rate": "+0%",
    "bam": "5ad7dfe5d645377c"
  },
  "gs-12": {
    "file": "gs-12.mp3",
    "kieu": "ten",
    "text": "Excuse me? Can you tell us the way to Tan Ky House?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tan Ky",
        "doc": "Tấn Ký",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "ade1b0190be7e8e7"
  },
  "gs-13": {
    "file": "gs-13.mp3",
    "kieu": "don",
    "text": "Sure. Go straight. Take the second turning on the left, and then turn right.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "af3fa2f8c7fd769a"
  },
