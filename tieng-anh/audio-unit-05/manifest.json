  },
  "prs-4": {
    "file": "prs-4.mp3",
    "kieu": "don",
    "text": "The Sahara is a very hot desert.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "721b0a2db6c33fe8"
  },
  "prs-5": {
    "file": "prs-5.mp3",
    "kieu": "don",
    "text": "I want to explore the island by boat.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "6c903711d76a232a"
  },
  "gr-01": {
    "file": "gr-01.mp3",
    "kieu": "don",
    "text": "Countable nouns are for the people and things we can count using numbers.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "22ecb5dc7d6190c5"
  },
  "gr-02": {
    "file": "gr-02.mp3",
    "kieu": "don",
    "text": "Countable nouns can be singular: a rock, an island, or plural: rocks, islands.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "09fb9b0ec87183fa"
  },
  "gr-03": {
    "file": "gr-03.mp3",
    "kieu": "don",
    "text": "Uncountable nouns are for the things that we cannot count with numbers.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0d163819030cf4ed"
  },
  "gr-04": {
    "file": "gr-04.mp3",
    "kieu": "don",
    "text": "They usually do not have a plural form: cream, chocolate.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "3f94aee2085f6b90"
  },
  "gr-05": {
    "file": "gr-05.mp3",
    "kieu": "don",
    "text": "We use some, many, a few with countable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8de0e1b77b1fb6a3"
  },
  "gr-06": {
    "file": "gr-06.mp3",
    "kieu": "don",
    "text": "We use some, much, a little with uncountable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e3c786be4bc6c6a6"
  },
  "gr-07": {
    "file": "gr-07.mp3",
    "kieu": "don",
    "text": "We use must to say that something is very necessary or very important.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e865b9d5c5d08d6c"
  },
  "gr-08": {
    "file": "gr-08.mp3",
    "kieu": "don",
    "text": "We use mustn't to say that doing something is not allowed.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "edf28e214b6c5f81"
  },
  "gr-09": {
    "file": "gr-09.mp3",
    "kieu": "don",
    "text": "We must arrive on time.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "71eb6e6bf474365c"
  },
  "gr-10": {
    "file": "gr-10.mp3",
    "kieu": "don",
    "text": "We mustn't pick flowers in the school garden.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a03b5d1d230d6049"
  },
  "com-01": {
    "file": "com-01.mp3",
    "kieu": "ten",
    "text": "Duong, let's go for a picnic this Sunday.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Duong",
        "doc": "Duong",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "f7383111718efbf6"
  },
  "com-02": {
    "file": "com-02.mp3",
    "kieu": "don",
    "text": "That's fine. What time can we meet?",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "6b4c01d8c5193f20"
  },
  "com-03": {
    "file": "com-03.mp3",
    "kieu": "don",
    "text": "How about nine o'clock?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "ab3b70d8c32bf64e"
  },
  "com-04": {
    "file": "com-04.mp3",
    "kieu": "don",
    "text": "Sure. I'll meet you at that time.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "8f8ddf72a3cf2b41"
  },
  "read-him-1": {
    "file": "read-him-1.mp3",
    "kieu": "don",
    "text": "The Himalayas is a mountain range. It's very special. It has the world's highest mountain – Mount Everest.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4364355644fe344d"
  },
  "read-him-2": {
    "file": "read-him-2.mp3",
    "kieu": "don",
    "text": "When visiting the Himalayas, remember to follow these rules.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "3779446b7c4daebc"
  },
  "rule-1": {
    "file": "rule-1.mp3",
    "kieu": "don",
    "text": "You must ask before you visit the area.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a706944e7803818e"
  },
  "rule-2": {
    "file": "rule-2.mp3",
    "kieu": "don",
    "text": "You mustn't travel alone. Always go in a group.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "d1c3384317b0b135"
  },
  "rule-3": {
    "file": "rule-3.mp3",
    "kieu": "don",
    "text": "You mustn't litter.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "f80da60598f06eb5"
  },
  "rule-4": {
    "file": "rule-4.mp3",
    "kieu": "don",
    "text": "You must bring only the necessary things.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "dea5c908a38a7376"
  },
  "rule-5": {
    "file": "rule-5.mp3",
    "kieu": "don",
    "text": "You must bring the right clothes too. Don't bring shorts or T-shirts!",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "3655705b4d65adb0"
  },
  "sp-01": {
    "file": "sp-01.mp3",
    "kieu": "don",
    "text": "I'd like to go to the Himalayas next month.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "845f859b3818ee8c"
  },
  "sp-02": {
    "file": "sp-02.mp3",
    "kieu": "don",
    "text": "OK. I think you must bring a waterproof coat. It's cold and rainy there!",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "18a6b08a624db272"
  },
  "sp-03": {
    "file": "sp-03.mp3",
    "kieu": "don",
    "text": "Yes. Anything else?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "695bd19088d946d2"
  },
  "read-halong": {
