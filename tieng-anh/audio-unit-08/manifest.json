    "bam": "ca7e20d3279f9cbd"
  },
  "gr-03": {
    "file": "gr-03.mp3",
    "kieu": "don",
    "text": "Did you do any sport last weekend?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "4d07ad0b112b27fd"
  },
  "gr-04": {
    "file": "gr-04.mp3",
    "kieu": "don",
    "text": "Oh yes, and I was exhausted.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "8f6cccfffdfe1db2"
  },
  "gr-05": {
    "file": "gr-05.mp3",
    "kieu": "don",
    "text": "Really? What did you do?",
    "voice": "en-GB-LibbyNeural",
    "rate": "+0%",
    "bam": "f2a69c855ddf8526"
  },
  "gr-06": {
    "file": "gr-06.mp3",
    "kieu": "don",
    "text": "We use imperatives to tell someone to do something, or to give a direct order.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "91f71a7b61db8b49"
  },
  "gr-07": {
    "file": "gr-07.mp3",
    "kieu": "don",
    "text": "It's a chewing gum.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "7892ffc284b955ab"
  },
  "gr-08": {
    "file": "gr-08.mp3",
    "kieu": "don",
    "text": "Chew it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "1c6b272a808e18b8"
  },
  "gr-09": {
    "file": "gr-09.mp3",
    "kieu": "don",
    "text": "Don't swallow it.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c545322c27ceaeb3"
  },
  "gr-10": {
    "file": "gr-10.mp3",
    "kieu": "don",
    "text": "Change your clothes.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "77ac7a1f348f06f4"
  },
  "gr-11": {
    "file": "gr-11.mp3",
