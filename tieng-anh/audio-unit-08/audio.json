    { "slug": "gs-01", "voice": "M", "text": "Wow! This gym is big!" },
    { "slug": "gs-02", "voice": "F", "text": "Yeah. The equipment is great. What sports do you do, Duong?", "ten_viet": [ { "tu": "Duong", "doc": "Dương" } ] },
    { "slug": "gs-03", "voice": "M", "text": "Well, I do karate, and I play table tennis. Yesterday I played with Duy, and I won!", "ten_viet": ["Duy"] },
    { "slug": "gs-04", "voice": "F", "text": "Congratulations! You look fit! I'm not good at sports." },
    { "slug": "gs-05", "voice": "M", "text": "I have an idea – you can go to the karate club with me." },
    { "slug": "gs-06", "voice": "F", "text": "No, I can't do karate." },
    { "slug": "gs-07", "voice": "M", "text": "But you can learn! You'll love it." },
    { "slug": "gs-08", "voice": "F", "text": "Well … OK." },
    { "slug": "gs-09", "voice": "M", "text": "Great! I'll meet you there at ten a.m. on Sunday." },
    { "slug": "gs-10", "voice": "F", "text": "Where's the club?" },
    { "slug": "gs-11", "voice": "M", "text": "It's Superfit Club, in Pham Hung  Road. You can cycle there.", "ten_viet": [ { "tu": "Pham Hung", "doc": "Phạm Hùng" } ] },
    { "slug": "gs-12", "voice": "F", "text": "OK. See you then." },

