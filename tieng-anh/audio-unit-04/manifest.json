  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "ten",
    "text": "Wow! We're in Hoi An. I'm so excited.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Hoi An",
        "doc": "Hội An",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "0d5030f0953ae22b"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "don",
    "text": "Me too. It's so beautiful. Where shall we go first?",
    "voice": "en-GB-ThomasNeural@+20Hz",
    "rate": "+0%",
    "bam": "7841ccce1812abe6"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "ten",
    "text": "Let's go to Chua Cau.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Chua Cau",
        "doc": "Chùa Cầu",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "65c6a3777e844443"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "ten",
    "text": "Well, but Tan Ky House is nearer. Shall we go there first?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tan Ky",
        "doc": "Tấn Ký",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "40fdfce905b74f9f"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "OK, sure.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "5f05715f79cf8bd7"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "First, cross the road, and then turn left.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "fb4693de3f6df798"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "Fine, let's go.",
    "voice": "en-GB-ThomasNeural@+20Hz",
    "rate": "+0%",
    "bam": "9d14efcfb30792f2"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Wait.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "05f8ac2672757ac3"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "ten",
    "text": "What's up, Phong?",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Phong",
        "doc": "Phong",
        "voice": "vi-VN-NamMinhNeural"
