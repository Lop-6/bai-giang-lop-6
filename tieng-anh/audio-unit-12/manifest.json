  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "don",
    "text": "Dr Adams! Can you tell us about the robots in the show, please?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "b0d297fa6cfc2cfc"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "don",
    "text": "Sure. This is H8, a home robot. It can do the dishes, iron clothes, put toys away …",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "d43bddbcef08da3d"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "don",
    "text": "It looks very useful!",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "7403bdcda2914cb6"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "don",
    "text": "Yes, it can even make meals.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "1b579bd937cb6d2e"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "don",
    "text": "Look! That's the biggest robot in the show.",
    "voice": "en-GB-ThomasNeural@+45Hz",
    "rate": "+0%",
    "bam": "b74c3b86c6203801"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "Right, it's WB2, a worker robot. It's the strongest and fastest robot here.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "4044925762775fc6"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "don",
    "text": "What can it do?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "7c8d71b640c43f02"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "It can move heavy things or repair broken machines.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "bd660b8964de33a1"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "don",
    "text": "And what is this?",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "59e7a67fed9a504c"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "don",
    "text": "It's Shifa, a doctor robot. It's the smartest robot. It can help sick people and do many things like humans.",
    "voice": "en-GB-ThomasNeural",
    "rate": "+0%",
    "bam": "ca5574a7ae513358"
  },
  "g5-01": {
    "file": "g5-01.mp3",
    "kieu": "don",
    "text": "What am I doing?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "9f43fcc172ef4f9a"
  },
  "g5-02": {
    "file": "g5-02.mp3",
