  "gr-u1-1": {
    "file": "gr-u1-1.mp3",
    "kieu": "don",
    "text": "We use the present simple to talk about actions or events that often happen, or are fixed.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "9489977445211044"
  },
  "gr-u1-2": {
    "file": "gr-u1-2.mp3",
    "kieu": "don",
    "text": "The present simple verbs with he / she / it need an s / es.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "087c3126b528e1c6"
  },
  "gr-u1-3": {
    "file": "gr-u1-3.mp3",
    "kieu": "don",
    "text": "We usually place the adverb of frequency before the main verb.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0c825f48838c7ac6"
  },
  "gr-u1-4": {
    "file": "gr-u1-4.mp3",
    "kieu": "don",
    "text": "Tom usually takes the bus to school.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "c23d1d7b57f1cda8"
  },
  "gr-u3-1": {
    "file": "gr-u3-1.mp3",
    "kieu": "don",
    "text": "When something often happens or is fixed, we use the present simple.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "eb880ad1c7f62948"
  },
  "gr-u3-2": {
    "file": "gr-u3-2.mp3",
    "kieu": "don",
    "text": "When something is happening now, we use the present continuous.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "5d045fabddc26a98"
  },
  "gr-u2-1": {
    "file": "gr-u2-1.mp3",
    "kieu": "don",
    "text": "We use 's after a proper name.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "0ca33dacf7cdb810"
  },
  "gr-u2-2": {
    "file": "gr-u2-2.mp3",
    "kieu": "don",
    "text": "This is Elena's room.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "b96f14682df45001"
  },
  "gr-u2-3": {
    "file": "gr-u2-3.mp3",
    "kieu": "don",
    "text": "We use 's after a singular noun.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "021f2e18143e14e8"
  },
  "gr-u2-4": {
    "file": "gr-u2-4.mp3",
    "kieu": "don",
    "text": "This is my mum's book.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "7b4e12eb32c95e4e"
  },
  "gr-u2-5": {
    "file": "gr-u2-5.mp3",
    "kieu": "don",
    "text": "Prepositions of place describe where people or things are.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8501c9b8a461ba21"
  },
  "gr-u2-6": {
    "file": "gr-u2-6.mp3",
    "kieu": "don",
    "text": "in, on, next to, behind",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "46247b41b09fac22"
  },
  "gr-u2-7": {
    "file": "gr-u2-7.mp3",
    "kieu": "don",
    "text": "in front of, under, between",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "61f556dc52582e5c"
  },
  "gr-u4-1": {
    "file": "gr-u4-1.mp3",
    "kieu": "don",
    "text": "We can use comparative adjectives to compare two people or things.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "cb208e8f687f681a"
  },
  "gr-u4-2": {
    "file": "gr-u4-2.mp3",
    "kieu": "don",
    "text": "Tom is taller than Mary.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "fd6b54064b835d9f"
  },
  "gr-u4-3": {
    "file": "gr-u4-3.mp3",
    "kieu": "don",
    "text": "A house in a city is normally more expensive than a house in the countryside.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "a7f8578a34b8dd5f"
  },
  "gr-u5-1": {
    "file": "gr-u5-1.mp3",
    "kieu": "don",
    "text": "We use some, many, a few with countable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "8de0e1b77b1fb6a3"
  },
  "gr-u5-2": {
    "file": "gr-u5-2.mp3",
    "kieu": "don",
    "text": "We use some, much, a little with uncountable nouns.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e3c786be4bc6c6a6"
  },
  "gr-u6-1": {
    "file": "gr-u6-1.mp3",
    "kieu": "don",
    "text": "My mother bought some fruits.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "cfd91f1e119972f9"
  },
  "gr-u6-2": {
    "file": "gr-u6-2.mp3",
    "kieu": "don",
    "text": "I need some milk for the cake.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "20e73f825b321111"
  },
  "gr-u6-3": {
    "file": "gr-u6-3.mp3",
    "kieu": "don",
    "text": "I can't answer any questions.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "db293c8142723feb"
  },
  "gr-u6-4": {
    "file": "gr-u6-4.mp3",
    "kieu": "don",
    "text": "Do you have any sugar?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "065b31d0d15bb0ba"
  },
  "gr-u5-3": {
    "file": "gr-u5-3.mp3",
    "kieu": "don",
    "text": "We use must to say that something is very necessary or very important.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "e865b9d5c5d08d6c"
  },
  "gr-u5-4": {
    "file": "gr-u5-4.mp3",
    "kieu": "don",
    "text": "We use mustn't to say that doing something is not allowed.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "edf28e214b6c5f81"
  },
  "gr-u6-5": {
    "file": "gr-u6-5.mp3",
    "kieu": "don",
    "text": "We use should for things that are good to do.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "d531d5accb0d7a73"
  },
  "gr-u6-6": {
    "file": "gr-u6-6.mp3",
    "kieu": "don",
    "text": "We use shouldn't for things that are not good to do.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "5312ae957b2e5207"
  },
  "rd-love-school": {
    "file": "rd-love-school.mp3",
    "kieu": "don",
    "text": "I love my school because it is a good school.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "44e099980307aeac"
  },
