    "bam": "dc467711bff21fec"
  },
  "g5-02": {
    "file": "g5-02.mp3",
    "kieu": "don",
    "text": "It has beautiful beaches.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
