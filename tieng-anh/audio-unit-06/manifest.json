  "gs-01": {
    "file": "gs-01.mp3",
    "kieu": "ten",
    "text": "Phong, does Viet Nam celebrate New Years?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Phong",
        "doc": "Phong",
        "voice": "vi-VN-HoaiMyNeural"
      },
      {
        "tu": "Viet Nam",
        "doc": "Việt Nam",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "2305328d4ce6b646"
  },
  "gs-02": {
    "file": "gs-02.mp3",
    "kieu": "ten",
    "text": "Yes, we do. We have Tet.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tet",
        "doc": "Tết",
        "voice": "vi-VN-NamMinhNeural"
      }
    ],
    "bam": "934cf61cd50b435b"
  },
  "gs-03": {
    "file": "gs-03.mp3",
    "kieu": "ten",
    "text": "When is Tet?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tet",
        "doc": "Tết",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "f3d3e28f2da890e9"
  },
  "gs-04": {
    "file": "gs-04.mp3",
    "kieu": "don",
    "text": "At different times. This year, it's in January.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "ed5b329489b91d0a"
  },
  "gs-05": {
    "file": "gs-05.mp3",
    "kieu": "ten",
    "text": "What do you do at Tet?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tet",
        "doc": "Tết",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "3a83506c85dbcfd9"
  },
  "gs-06": {
    "file": "gs-06.mp3",
    "kieu": "don",
    "text": "We clean our homes and decorate them with flowers.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "472de1b3c5b1b274"
  },
  "gs-07": {
    "file": "gs-07.mp3",
    "kieu": "ten",
    "text": "Is Tet a time for family gatherings?",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "ten_viet": [
      {
        "tu": "Tet",
        "doc": "Tết",
        "voice": "vi-VN-HoaiMyNeural"
      }
    ],
    "bam": "9efcc035cf0eefd9"
  },
  "gs-08": {
    "file": "gs-08.mp3",
    "kieu": "don",
    "text": "Yes. It's a happy time for everybody.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
    "bam": "8e0456b6b12a0c2f"
  },
  "gs-09": {
    "file": "gs-09.mp3",
    "kieu": "don",
    "text": "Great.",
    "voice": "en-GB-SoniaNeural",
    "rate": "+0%",
    "bam": "211ce6b7c1caa61b"
  },
  "gs-10": {
    "file": "gs-10.mp3",
    "kieu": "ten",
    "text": "Yes, and another good thing about Tet is that children get lucky money.",
    "voice": "en-GB-RyanNeural",
    "rate": "+0%",
